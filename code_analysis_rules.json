{
  "log_level": "all",
  "fail_on": "warning",
  "max_errors": 50,
  "max_lines_per_file": {
    "enabled": true,
    "warning": 300,
    "error": 500,
    "exclude_patterns": [
      ".git/**",
      ".claude/**",
      ".gradle/**",
      ".idea/**",
      ".kotlin/**",
      "build/**",
      "app/build/**",
      "code_analysis_results/**",
      "graphify-out/**",
      "tickets/**",
      "tmp/**",
      "tools/**"
    ]
  },
  "pmd_duplicates": {
    "enabled": true,
    "minimum_tokens": 100,
    "exclude_patterns": {
      "kotlin": [
        ".git/**",
        ".gradle/**",
        ".idea/**",
        ".kotlin/**",
        "build/**",
        "app/build/**",
        "code_analysis_results/**",
        "graphify-out/**",
        "tickets/**",
        "tmp/**",
        "tools/**"
      ]
    }
  },
  "pmd_similar_code": {
    "enabled": false
  },
  "kotlin_complexity": {
    "enabled": true,
    "cyclomatic_complexity": {"warning": 10, "error": 15, "exceptions": []},
    "function_length": {
      "warning": 50,
      "error": 100,
      "exceptions": [
        {
          "file": "app/src/main/java/com/dessalines/thumbkey/ui/components/keyboard/KeyboardKeys.kt",
          "warning": 60,
          "reason": "ScreenKey adapts the extracted keyboard environment to the existing KeyboardKey call API."
        }
      ]
    },
    "parameter_count": {"warning": 5, "error": 8, "exceptions": []}
  }
}
